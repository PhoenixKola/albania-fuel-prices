# Public build-time settings, bundled into the website. Never put secrets here.
# Local/preview hosts cannot request live ads, even if these flags are enabled.
VITE_DEPLOY_ENV=preview
VITE_ADS_ENABLED=false
# Set true only after publishing Google's certified Privacy & messaging flow.
VITE_ADS_CMP_PUBLISHED=false
# Real manual display-unit IDs from your AdSense account (one per placement).
VITE_AD_SLOT_HOME=
VITE_AD_SLOT_CONTENT=
VITE_AD_SLOT_ARTICLE_END=
# Paste the entire HTTPS Albania link generated by the direct DiscoverCars program.
# Must use discovercars.com and include the genuine a_aid tracking parameter.
VITE_RENTAL_URL=
# Optional per-placement campaign URLs; blank values use VITE_RENTAL_URL.
VITE_RENTAL_URL_CALCULATOR=
VITE_RENTAL_URL_GUIDE=
VITE_RENTAL_URL_ROAD_TRIP=
VITE_RENTAL_URL_ALBANIA=
# 32-character public Cloudflare Web Analytics site token.
VITE_CF_ANALYTICS_TOKEN=
